# Copy to .env and adjust. All variables are prefixed with PILOADING_. Every value
# shown is the built-in default except PILOADING_VIESSMANN_CLIENT_ID (required for
# live mode) and PILOADING_GOE_HOST (almost certainly needs to change).

# Runtime mode: "mock" (simulated day, safe for development) or "live" (real hardware).
PILOADING_MODE=mock
# When true, reads real data and logs decisions but never writes to the wallbox.
# Use this for the first live run before trusting piLoading with the real car.
PILOADING_DRY_RUN=false

# --- go-e Wallbox (local network, no auth) ---
PILOADING_GOE_HOST=192.168.1.50
PILOADING_GOE_POLL_INTERVAL_S=7

# --- Viessmann Vitocharge VX3 (cloud OAuth2/PKCE Developer API) ---
# Client ID from https://developer.viessmann-climatesolutions.com — register a client
# there with redirect URI http://localhost:4200/callback, then run `piloading auth-viessmann`
# once on a machine with a browser (see README).
PILOADING_VIESSMANN_CLIENT_ID=
# Where auth-viessmann stores tokens (viessmann_auth.json). Copy this directory to the
# Pi after running auth-viessmann on your Mac; the Pi never runs auth-viessmann itself.
PILOADING_VIESSMANN_CONFIG_DIR=~/.config/piloading
PILOADING_VIESSMANN_POLL_INTERVAL_S=60
PILOADING_VIESSMANN_STALE_WARN_S=300
PILOADING_VIESSMANN_STALE_STOP_S=900
# Flip if grid_power_w has the opposite sign than expected (positive should mean
# importing from the grid) — verify empirically, see README.
PILOADING_INVERT_GRID_POWER_SIGN=false

# --- Electrical setup ---
PILOADING_VOLTAGE=230
PILOADING_MIN_AMP=6
PILOADING_MAX_AMP=16
PILOADING_ENABLE_PHASE_SWITCHING=true

# --- Control algorithm timing ---
PILOADING_GRID_POWER_SMOOTHING_SAMPLES=5
PILOADING_TARGET_GRID_POWER_W=0
PILOADING_START_DELAY_S=90
PILOADING_STOP_DELAY_S=90
PILOADING_PHASE_SWITCH_SUSTAIN_S=300
PILOADING_PHASE_SWITCH_MIN_INTERVAL_S=600
PILOADING_CONTROL_INTERVAL_S=10

# --- Storage / web dashboard ---
PILOADING_DB_PATH=~/.local/share/piloading/history.db
PILOADING_WEB_HOST=0.0.0.0
PILOADING_WEB_PORT=8080
