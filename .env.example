# Copy to .env and adjust. All variables are prefixed with PILOADING_. Every value
# shown is the built-in default except PILOADING_VIESSMANN_CLIENT_ID (required for
# live mode) and PILOADING_GOE_HOST (almost certainly needs to change).

# Runtime mode: "mock" (simulated day, safe for development) or "live" (real hardware).
PILOADING_MODE=mock
# When true, reads real data and logs decisions but never writes to the wallbox.
# Use this for the first live run before trusting piLoading with the real car.
PILOADING_DRY_RUN=false

# --- go-e Wallbox (local network, no auth) ---
# IP address (or hostname) of the go-e wallbox on your local network.
PILOADING_GOE_HOST=192.168.1.50
# How often to poll the wallbox for a new car_state, in seconds — but only while no car
# is connected or a charge just finished. While a car is connected and possibly
# charging, go-e is instead polled every PILOADING_CONTROL_INTERVAL_S, together with
# Viessmann; the Viessmann API is not queried at all during the idle periods this
# setting covers.
PILOADING_GOE_POLL_INTERVAL_S=60

# --- Viessmann Vitocharge VX3 (cloud OAuth2/PKCE Developer API) ---
# Client ID from https://developer.viessmann-climatesolutions.com — register a client
# there with redirect URI http://localhost:4200/callback, then run `piloading auth-viessmann`
# once on a machine with a browser (see README).
PILOADING_VIESSMANN_CLIENT_ID=
# Where auth-viessmann stores tokens (viessmann_auth.json). Copy this directory to the
# Pi after running auth-viessmann on your Mac; the Pi never runs auth-viessmann itself.
PILOADING_VIESSMANN_CONFIG_DIR=~/.config/piloading
# If the last successful battery reading is older than this, stop increasing charge
# current (log a warning) but keep the current charging state.
PILOADING_VIESSMANN_STALE_WARN_S=300
# If the last successful battery reading is older than this, stop charging entirely —
# safety fallback for a hung/unreachable Viessmann API.
PILOADING_VIESSMANN_STALE_STOP_S=900
# Flip if grid_power_w has the opposite sign than expected (positive should mean
# importing from the grid) — verify empirically, see README.
PILOADING_INVERT_GRID_POWER_SIGN=false

# --- Electrical setup ---
# Grid voltage per phase, used to convert between Watts and Amps.
PILOADING_VOLTAGE=230
# Lowest charging current the wallbox/car will accept; charging never runs below this.
PILOADING_MIN_AMP=6
# Highest charging current to ever request, even if surplus would allow more.
PILOADING_MAX_AMP=16
# If true, automatically switch between 1-phase and 3-phase charging depending on
# how much surplus is available.
PILOADING_ENABLE_PHASE_SWITCHING=true

# --- Control algorithm timing ---
# Number of recent grid readings averaged before deciding, to avoid reacting to
# short-lived spikes/dips.
PILOADING_GRID_POWER_SMOOTHING_SAMPLES=5
# Grid power setpoint the controller tries to hold, in Watts (positive = import,
# negative = export). E.g. -200 keeps ~200W always flowing to the grid as a buffer
# against sudden cloud cover.
PILOADING_TARGET_GRID_POWER_W=-200
# How long surplus must stay sufficient before charging actually starts.
PILOADING_START_DELAY_S=90
# How long surplus must stay insufficient before charging actually stops.
PILOADING_STOP_DELAY_S=90
# How long a phase-count change condition must hold before actually switching, to
# avoid toggling the contactor on brief fluctuations.
PILOADING_PHASE_SWITCH_SUSTAIN_S=300
# Minimum time between two phase switches, since each one drives a physical contactor.
PILOADING_PHASE_SWITCH_MIN_INTERVAL_S=600
# Minimum time between amp changes sent to the wallbox. The go-e takes ~10s to ramp to
# a newly set amp value, so recomputing/re-sending every control cycle would chase a
# value that hasn't settled yet.
PILOADING_AMP_CHANGE_COOLDOWN_S=15
# How often the control loop reads sensors and re-evaluates the charging decision.
# Whenever a car is connected and possibly charging, this is also how often *both* the
# go-e wallbox and the Viessmann battery system are polled — one read of each per
# cycle. (When idle, see PILOADING_GOE_POLL_INTERVAL_S instead.)
PILOADING_CONTROL_INTERVAL_S=10
# How long a sustained deficit (insufficient surplus, e.g. after sunset) must persist
# before switching to night mode (see PILOADING_NIGHT_MODE_POLL_INTERVAL_S below) — this
# keeps Viessmann from being polled every PILOADING_CONTROL_INTERVAL_S all night, which
# would otherwise risk hitting its daily API rate limit.
PILOADING_NIGHT_MODE_AFTER_S=600
# Poll interval used once night mode is active, instead of PILOADING_CONTROL_INTERVAL_S.
# As soon as surplus becomes sufficient again, the loop switches back to the normal
# interval immediately and resumes charging.
PILOADING_NIGHT_MODE_POLL_INTERVAL_S=600

# --- Storage / web dashboard ---
# SQLite file storing historical readings/decisions shown on the dashboard.
PILOADING_DB_PATH=~/.local/share/piloading/history.db
# Bind address for the dashboard's web server (0.0.0.0 = reachable from other devices).
PILOADING_WEB_HOST=0.0.0.0
# Port for the dashboard's web server.
PILOADING_WEB_PORT=8080
